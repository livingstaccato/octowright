# act configuration for octowright
# https://github.com/nektos/act

# Runner images — use act-24.04 (includes node in PATH; act-latest doesn't).
-P ubuntu-latest=catthehacker/ubuntu:act-24.04
-P ubuntu-24.04=catthehacker/ubuntu:act-24.04
-P ubuntu-22.04=catthehacker/ubuntu:act-22.04

# Apple Silicon: force amd64 emulation so images pulled for x86_64 work.
--container-architecture linux/amd64

# Colima compatibility: don't bind-mount the host daemon socket path.
--container-daemon-socket -

# Avoid non-loopback bind selection issues in some local environments.
--artifact-server-addr 127.0.0.1
--cache-server-addr 127.0.0.1
--no-cache-server

# Pull images if needed (first run).
--pull

# Default workflow.
--workflows .github/workflows/ci.yml
