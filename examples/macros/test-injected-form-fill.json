{
  "name": "test-injected-form-fill",
  "description": "[test] Inject a form, fill #user and #pass, assert the values via expect_js. No external network.",
  "parameters": [],
  "created_at": "2026-04-24T00:00:00Z",
  "updated_at": "2026-04-24T00:00:00Z",
  "actions": [
    {
      "action": "evaluate",
      "expression": "document.body.innerHTML = '<input id=user><input id=pass type=password>'"
    },
    {
      "action": "fill",
      "selector": "#user",
      "value": "cosmo"
    },
    {
      "action": "fill",
      "selector": "#pass",
      "value": "hunter2"
    },
    {
      "action": "expect_js",
      "expression": "document.querySelector('#user').value",
      "equals": "cosmo"
    },
    {
      "action": "expect_js",
      "expression": "document.querySelector('#pass').value",
      "equals": "hunter2"
    }
  ]
}
