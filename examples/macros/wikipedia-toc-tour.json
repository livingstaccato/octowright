{
  "name": "wikipedia-toc-tour",
  "description": "[demo] Navigate Wikipedia's Playwright article via the table of contents. Click History, then References. Uses ARIA role+name selectors that survive Wikipedia's article-page rewrites.",
  "parameters": [],
  "created_at": "2026-05-11T00:00:00Z",
  "updated_at": "2026-05-11T00:00:00Z",
  "actions": [
    {"action": "wait_for", "selector": "h1#firstHeading", "timeout_ms": 10000},
    {"action": "expect_url", "pattern": "Playwright", "mode": "contains"},
    {"action": "click_by", "role": "link", "role_name": "History", "role_exact": true},
    {"action": "wait_for", "expression": "location.hash.includes('History') || document.querySelector('h2#History, h3#History, span#History')", "timeout_ms": 5000},
    {"action": "click_by", "role": "link", "role_name": "References", "role_exact": true},
    {"action": "wait_for", "expression": "location.hash.includes('References') || document.querySelector('h2#References, h3#References, span#References')", "timeout_ms": 5000},
    {"action": "screenshot"}
  ]
}
