    {"action": "expect_text", "selector": "h1", "text": "pill probe"},
    {"action": "evaluate", "expression": "new Promise(r => { document.body.style.background = '#e6f7ff'; setTimeout(r, 1500); })"},
    {"action": "expect_selector", "selector": "p"},
    {"action": "evaluate", "expression": "new Promise(r => { document.body.style.background = '#f6ffed'; setTimeout(r, 1500); })"},
    {"action": "expect_url", "pattern": "probe", "mode": "contains"},
    {"action": "evaluate", "expression": "new Promise(r => { document.body.style.background = '#fff1f0'; setTimeout(r, 1500); })"}
  ]
