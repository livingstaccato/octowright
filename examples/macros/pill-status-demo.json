{
  "name": "pill-status-demo",
  "description": "Multi-step macro for visually exercising the bottom-center status pill: 3 evaluates with real 1.5s delays interleaved with 3 different assertion types (expect_text, expect_selector, expect_url). Run against examples/pill-status-demo/probe.html.",
  "parameters": [],
  "created_at": "2026-05-07T00:00:00Z",
