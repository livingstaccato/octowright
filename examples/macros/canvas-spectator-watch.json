{
  "name": "canvas-spectator-watch",
  "description": "[demo] Spectator role: scroll the canvas grid into view, hover several tiles to draw attention, screenshot.",
  "parameters": [],
  "created_at": "2026-05-12T00:00:00Z",
  "updated_at": "2026-05-12T00:00:00Z",
  "actions": [
    {"action": "wait_for", "selector": "#grid", "timeout_ms": 10000},
    {"action": "evaluate", "expression": "document.querySelector('#grid').scrollIntoView({block: 'center', behavior: 'smooth'}); window.scrollY"},
    {"action": "hover", "selector": "[data-testid='tile-2-2']"},
    {"action": "hover", "selector": "[data-testid='tile-5-5']"},
    {"action": "hover", "selector": "[data-testid='tile-8-8']"},
    {"action": "screenshot"}
  ]
}
