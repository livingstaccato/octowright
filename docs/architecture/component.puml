@startuml component
title octowright — module layout

skinparam backgroundColor #ffffff
skinparam defaultFontColor #333333
skinparam componentBorderColor #d1d5db
skinparam componentBackgroundColor #f3f4f6
skinparam packageBorderColor #d1d5db
skinparam packageBackgroundColor #ffffff
skinparam arrowColor #2563eb
skinparam noteBorderColor #d1d5db
skinparam noteBackgroundColor #f9fafb

' Force top-to-bottom layering so user surfaces sit above live state
' above session modules above the Playwright SDK boundary. Without this,
' the Playwright cloud gets placed off to a side, forcing session→PW
' and pool→PW arrows to cross multiple layers.
top to bottom direction

package "user surfaces" #eff6ff {
  [server/\nMCPServer (134 tools, 141 with the terminal\nplugin; slimmable via --profile)] as SERVER
  [cli/\nclick: serve / test / scenario / persona /\nrestart / doctor / dashboard / cleanup] as CLI
  [http/\nStarlette dashboard + /mcp follower proxy] as HTTP
}

package "live state" #fef3c7 {
  [BrowserPool\nbrowser_pool/pool.py] as POOL
  [BrowserSession\nsession/core.py] as SESSION
  [ScenarioPool\nscenarios_pool.py] as SPOOL
}

package "domain modules" #ecfccb {
  [personas.py\nPersona, load, migrate,\ncreds (_env / _cmd / _file)] as PERSONAS
  [engine_profiles.py\nengine-profile path layer] as ENGPROF
  [scenarios.py\nScenario, Participant, loaders] as SCENARIOS
  [macros/\nstorage, import, substitute, run, repair,\nprivacy ledgers + scrub cap, sequence steps] as MACROS
  [runner.py\ntest-tagged macros or --sequence file → JUnit\n(runner_video.py: --record-video)] as RUNNER
  [sequences.py\nsequence files: names + args_list as data] as SEQUENCES
  [persona_trust.py\nper-persona Chromium trust store] as PTRUST
  [goldens.py\naria-tree snapshots + diff] as GOLDENS
  [video.py\nffmpeg frame extraction] as VIDEO
  [stabilize.py\ndeterminism init script] as STABILIZE
}

package "session modules" #fdf4ff {
  [session/operation/gate/core.py\nSessionOperationGate: FIFO per-session\nserialization, exact-task reentrancy] as GATE
  [session/frames.py] as SF
  [session/downloads.py] as SD
  [session/locators.py] as SL
  [session/fill_origin.py\ncredential fill bound to a checked origin] as SFO
}

package "infrastructure" #f3f4f6 {
  [defaults.py\nenv vars + paths] as DEFAULTS
  [recorder.py\nappend-only JSONL] as RECORDER
  [export.py\nrecording → playwright script] as EXPORT
  [upgrade/\npost-upgrade "what's new" notice] as UPGRADE
  ' Package-root shared helpers. They sit at the root deliberately: server/,
  ' session/ and the root summarizers all need them, and putting one inside
  ' any of those layers makes the others import a layer they have no business
  ' importing. Measured cost of getting this wrong: routing console levels
  ' through session/_constants took capture_summaries from 6 stdlib imports
  ' to 508, including Playwright.
  [dashboard_events.py\nin-process pub/sub for SSE/WS fanout] as DASHEVENTS
  [console_levels.py\ncanonical console-level classification] as CONSOLELEVELS
  [http_headers.py\nheader validation + record-time redaction] as HTTPHEADERS
  ' Rendered verbatim into the exported macro CLI, so stdlib only: the live
  ' replay and the generated script refuse the same credential sinks.
  [credential_sinks.py + credential_input.py\ncredential sink + fill-origin rules\n(shared with the exported macro CLI)] as CREDSINKS
  [request_failures.py\nexpect_network_clean ledger\n(shared with the exported macro CLI)] as REQFAIL
}

' Playwright sits below everything that talks to it; only BrowserSession
' and BrowserPool drive it, so the arrows stay vertical and short.
cloud "Playwright async API" as PW

' ── user surfaces drive live state ──
CLI --> POOL
CLI --> SPOOL
SERVER --> POOL
SERVER --> SPOOL
HTTP --> POOL
HTTP --> SPOOL

' ── live state composition ──
POOL "1" *-- "*" SESSION : owns
SPOOL "1" o-- "*" SESSION : participants
SESSION "1" *-- "1" GATE : owns
SESSION ..> SF
SESSION ..> SD
SESSION ..> SL
SESSION ..> SFO
SFO ..> CREDSINKS : origin check

' ── domain dependencies ──
POOL ..> ENGPROF : engine_profile_dir
POOL ..> STABILIZE : init script
POOL ..> PTRUST : HOME for a persona\nwith trusted_roots
SCENARIOS ..> PERSONAS : default URL / macros / creds
SCENARIOS ..> MACROS : run_macro per participant
SCENARIOS ..> POOL : spawn_roster
RUNNER ..> MACROS
RUNNER ..> POOL : ephemeral browser per [test]\nor one per sequence
RUNNER ..> SEQUENCES : --sequence
MACROS ..> CREDSINKS : sink guard
SESSION ..> REQFAIL : expect_network_clean
SERVER ..> RUNNER
SERVER ..> GOLDENS
SERVER ..> VIDEO
SERVER ..> MACROS
SERVER ..> UPGRADE : upgrade block in octowright_status
CLI ..> UPGRADE : announce on leader start

' ── artifacts ──
SESSION ..> RECORDER : every action
SESSION ..> EXPORT : on demand
ENGPROF --> PERSONAS : delegates path resolution

' ── playwright (kept vertical by top-to-bottom direction) ──
SESSION --> PW
POOL --> PW

' Anchor PW below session modules / infrastructure so the SESSION→PW
' and POOL→PW arrows stay short and vertical instead of crossing the
' whole diagram diagonally. Without these hints PlantUML places PW
' wherever Graphviz feels like, usually bottom-left.
SF -[hidden]down-> PW
SD -[hidden]down-> PW
SL -[hidden]down-> PW

@enduml
