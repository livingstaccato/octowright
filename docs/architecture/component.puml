@startuml component
title octowright — module layout

skinparam backgroundColor #ffffff
skinparam defaultFontColor #333333
skinparam componentBorderColor #d1d5db
skinparam componentBackgroundColor #f3f4f6
skinparam packageBorderColor #d1d5db
skinparam packageBackgroundColor #ffffff
skinparam arrowColor #2563eb
skinparam noteBorderColor #d1d5db
skinparam noteBackgroundColor #f9fafb

' Force top-to-bottom layering so user surfaces sit above live state
' above session modules above the Playwright SDK boundary. This stops
' the Playwright cloud from being placed off to a side, which used to
' force session→PW and pool→PW arrows to cross multiple layers.
top to bottom direction

package "user surfaces" #eff6ff {
  [server.py\nFastMCP (126 tools, slimmable via --profile)] as SERVER
  [cli.py\nclick: serve / test / scenario / persona] as CLI
}

package "live state" #fef3c7 {
  [BrowserPool\nbrowser_pool/pool.py] as POOL
  [BrowserSession\nsession/core.py] as SESSION
  [ScenarioPool\nscenarios_pool.py] as SPOOL
}

package "domain modules" #ecfccb {
  [personas.py\nPersona, load, migrate, creds] as PERSONAS
  [engine_profiles.py\nengine-profile path layer] as ENGPROF
  [scenarios.py\nScenario, Participant, loaders] as SCENARIOS
  [macros/\nstorage, import, substitute, run, repair] as MACROS
  [runner.py\ntest-macro discovery + JUnit] as RUNNER
  [goldens.py\naria-tree snapshots + diff] as GOLDENS
  [video.py\nffmpeg frame extraction] as VIDEO
  [stabilize.py\ndeterminism init script] as STABILIZE
}

package "session modules" #fdf4ff {
  [session/operation_gate.py\nSessionOperationGate: FIFO per-session\nserialization, exact-task reentrancy] as GATE
  [session/frames.py] as SF
  [session/downloads.py] as SD
  [session/locators.py] as SL
}

package "infrastructure" #f3f4f6 {
  [defaults.py\nenv vars + paths] as DEFAULTS
  [recorder.py\nappend-only JSONL] as RECORDER
  [export.py\nrecording → playwright script] as EXPORT
  [upgrade.py\npost-upgrade "what's new" notice] as UPGRADE
}

' Playwright sits below everything that talks to it; only BrowserSession
' and BrowserPool drive it, so the arrows stay vertical and short.
cloud "Playwright async API" as PW

' ── user surfaces drive live state ──
CLI --> POOL
CLI --> SPOOL
SERVER --> POOL
SERVER --> SPOOL

' ── live state composition ──
POOL "1" *-- "*" SESSION : owns
SPOOL "1" o-- "*" SESSION : participants
SESSION "1" *-- "1" GATE : owns
SESSION ..> SF
SESSION ..> SD
SESSION ..> SL

' ── domain dependencies ──
POOL ..> ENGPROF : engine_profile_dir
POOL ..> STABILIZE : init script
SCENARIOS ..> PERSONAS : default URL / macros / creds
SCENARIOS ..> MACROS : run_macro per participant
SCENARIOS ..> POOL : spawn_roster
RUNNER ..> MACROS
RUNNER ..> POOL : ephemeral browser per [test]
SERVER ..> RUNNER
SERVER ..> GOLDENS
SERVER ..> VIDEO
SERVER ..> MACROS
SERVER ..> UPGRADE : upgrade block in octowright_status
CLI ..> UPGRADE : announce on leader start

' ── artifacts ──
SESSION ..> RECORDER : every action
SESSION ..> EXPORT : on demand
ENGPROF --> PERSONAS : delegates path resolution

' ── playwright (kept vertical by top-to-bottom direction) ──
SESSION --> PW
POOL --> PW

' Anchor PW below session modules / infrastructure so the SESSION→PW
' and POOL→PW arrows stay short and vertical instead of crossing the
' whole diagram diagonally. Without these hints PlantUML places PW
' wherever Graphviz feels like, usually bottom-left.
SF -[hidden]down-> PW
SD -[hidden]down-> PW
SL -[hidden]down-> PW

@enduml
