@startuml macro-lifecycle
title Macro lifecycle — record, save, replay, repair, test

skinparam backgroundColor #ffffff
skinparam defaultFontColor #333333
skinparam activityBorderColor #d1d5db
skinparam activityBackgroundColor #f3f4f6
skinparam activityDiamondBorderColor #d1d5db
skinparam activityDiamondBackgroundColor #fef3c7
skinparam arrowColor #2563eb
skinparam noteBackgroundColor #f9fafb
skinparam noteBorderColor #d1d5db

|user|
start
:browser_launch + drive interactively;
:every action recorded as JSONL line\n(recorder.record(...) ⟶ <log>.jsonl);

|saving|
:macro_save(instance_id, name,\nparameters={"email":"me@x", ...});
note right
  parameters are literal values to swap
  for {{name}} placeholders
end note
:strip launch / close / snapshot\n+ passive recorder rows;
:write JSON to MACROS_DIR/<slug>.json;

|replay|
:macro_run(instance_id, name,\nargs={"email":"other@x"});
:load_macro;
:classify argument leaves by\ncredential / identity / contextual tier;
:resolve OCTOWRIGHT_MACRO_BLIND_SCRUB_POLICY\n(credentials default / all / reject);
if (reject + identity/context value?) then (yes)
  :raise value-free policy error\nbefore browser or artifact side effects;
  stop
else (no)
  :structurally redact every classified key;
  :select blind-scrub values by policy;\nunder all, skip identity/context values\nshorter than the floor or on the common list\n(reported as scrub_exempt_args, by path);
  :append credentials to run + permanent\nsession privacy ledgers; identity/context\nvalues to run ledger + this run's session scope\n(dropped when the run ends);
  if (new persistent value, session scrub set\nat OCTOWRIGHT_MACRO_SCRUB_MAX_VALUES?) then (yes)
    :refuse the run before it does anything\n(session stays scrub_saturated; no value dropped);
    stop
  else (no)
  endif
endif
:substitute {{...}} from args;
:dispatch each action through BrowserSession\n(navigate, click, fill, expect_*, expect_network_clean,\nexpect_no_text, mock_route, ...);
note right
  A fill/type of a credential-tier value is typed only
  into a document whose origin passed the check, read
  from the frame that receives it (session/fill_origin.py);
  OCTOWRIGHT_MACRO_CREDENTIAL_FILL_ORIGINS=block|warn.
end note
if (any action raises?) then (yes)
  :auto-capture diagnostic_bundle\n(html→disk, console_tail, screenshot, url, title)\n+ failed_requests, page_errors;
  :raise RuntimeError({macro, failed_at_step,\nfailed_action, original, bundle, assertions,\nscreenshot refusal reasons/tiers/args — never values});
  stop
else (no)
  :return {macro, executed, skipped, args_used,\nassertions, scrub_exempt_args?, scrub_saturated?};
endif

|sequence|
start
:macro_run_sequence(names, args_list,\nstop_on_failure=True);
note right
  One lease + one macro read for the whole walk.
  A failing step is a RESULT, never a raise:
  {sequence, steps[], ok, stopped_at}.
  Only malformed inputs, the operation gate
  and cancellation still raise.
end note
stop

|repair|
note right
  When replay fails on a selector, walk the
  resilience ladder before re-recording.
  (Runtime already tries the stored semantic
  locator before the recorded CSS selector.)
end note
start
:macro_repair_preview(name);
note right
  Non-mutating: per selector-based action,
  the stored semantic replacement candidate
  (click → click_by) + a review prompt.
end note
if (stored semantic locator?) then (yes)
  :macro_repair_apply(name, action_index);
  note right
    Rewrites the brittle selector into
    click_by / fill_by (role/label/text/test_id),
    drops the stale CSS selector, saves in place.
  end note
  :macro_run again;
else (no / structural change)
  :re-record the flow\n(macros are a disposable cache);
endif
stop

|test mode|
:octowright test [--tag <tag> | ~--sequence <file>]\n[~--persona] [~--artifacts] [~--record-video];
if (~--sequence?) then (yes)
  :resolve every {"credential": ...} /\n{"artifact": ...} arg before launch;
  :run steps in ONE browser of the persona;\nsteps after a failure reported skipped;
else (no)
  note right
    Discovers macros whose **description**
    starts with [test] or [test:<tag>].
    Launches an ephemeral browser per macro
    on about:blank.
  end note
  :run_suite per [test] macro;
  if (run_macro raised?) then (yes)
    :record failure + duration;
  else (no)
    :record pass + duration;
  endif
endif
:write JUnit XML report\n(+ video: <path> per page with ~--record-video);
stop

|scenario test mode|
start
:scenario_run_as_test(scenario_id);
:for each live participant:\nlook up verify[role] → run_macro;
:write JUnit XML;
:return {total, passed, failed, results};
stop

@enduml
