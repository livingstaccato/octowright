@startuml macro-lifecycle
title Macro lifecycle — record, save, replay, repair, test

skinparam backgroundColor #ffffff
skinparam defaultFontColor #333333
skinparam activityBorderColor #d1d5db
skinparam activityBackgroundColor #f3f4f6
skinparam activityDiamondBorderColor #d1d5db
skinparam activityDiamondBackgroundColor #fef3c7
skinparam arrowColor #2563eb
skinparam noteBackgroundColor #f9fafb
skinparam noteBorderColor #d1d5db

|user|
start
:browser_launch + drive interactively;
:every action recorded as JSONL line\n(recorder.record(...) ⟶ <log>.jsonl);

|saving|
:macro_save(instance_id, name,\nparameters={"email":"me@x", ...});
note right
  parameters are literal values to swap
  for {{name}} placeholders
end note
:strip launch / close / snapshot;
:write JSON to MACROS_DIR/<slug>.json;

|replay|
:macro_run(instance_id, name,\nargs={"email":"other@x"});
:load_macro;
:classify argument leaves by\ncredential / identity / contextual tier;
:resolve OCTOWRIGHT_MACRO_BLIND_SCRUB_POLICY\n(credentials default / all / reject);
if (reject + identity/context value?) then (yes)
  :raise value-free policy error\nbefore browser or artifact side effects;
  stop
else (no)
  :structurally redact every classified key;
  :select blind-scrub values by policy;
  :append selected values to run +\npermanent session privacy ledgers;
endif
:substitute {{...}} from args;
:dispatch each action through BrowserSession\n(navigate, click, fill, expect_*, mock_route, ...);
if (any action raises?) then (yes)
  :auto-capture diagnostic_bundle\n(html→disk, console_tail, screenshot, url, title);
  :raise RuntimeError({macro, failed_at_step,\nfailed_action, original, bundle});
  stop
else (no)
  :return {macro, executed, skipped, args_used};
endif

|repair|
note right
  When replay fails on a selector, walk the
  resilience ladder before re-recording.
  (Runtime already tries the stored semantic
  locator before the recorded CSS selector.)
end note
start
:macro_repair_preview(name);
note right
  Non-mutating: per selector-based action,
  the stored semantic replacement candidate
  (click → click_by) + a review prompt.
end note
if (stored semantic locator?) then (yes)
  :macro_repair_apply(name, action_index);
  note right
    Rewrites the brittle selector into
    click_by / fill_by (role/label/text/test_id),
    drops the stale CSS selector, saves in place.
  end note
  :macro_run again;
else (no / structural change)
  :re-record the flow\n(macros are a disposable cache);
endif
stop

|test mode|
:octowright test [--tag <tag>];
note right
  Discovers macros whose **description**
  starts with [test] or [test:<tag>].
  Launches an ephemeral browser per macro
  on about:blank.
end note
:run_suite per [test] macro;
if (run_macro raised?) then (yes)
  :record failure + duration;
else (no)
  :record pass + duration;
endif
:write JUnit XML report;
stop

|scenario test mode|
start
:scenario_run_as_test(scenario_id);
:for each live participant:\nlook up verify[role] → run_macro;
:write JUnit XML;
:return {total, passed, failed, results};
stop

@enduml
